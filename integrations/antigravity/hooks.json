{
  "cwagent-keep-playing": {
    "PostToolUse": [
      {
        "matcher": ".*mcp.*|.*cwagent.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook.py post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/hook.py stop",
        "timeout": 10
      }
    ]
  }
}
